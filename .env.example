# --- Django ------------------------------------------------------------------
# SECRET_KEY : à générer avec la commande :
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=django-insecure-change-this-in-production-abc123xyz789

# DEBUG : False dès que l'application est en ligne (active HTTPS obligatoire,
# cookies sécurisés, HSTS).
DEBUG=False

# Domaines autorisés, séparés par des virgules. En local :
#   DEBUG=True -> ALLOWED_HOSTS=localhost,127.0.0.1
# Sur le serveur, mets le nom public et l'IP du serveur :
ALLOWED_HOSTS=exemple.com,www.exemple.com,203.0.113.10

# --- Base de données ---------------------------------------------------------
# Par défaut (commenté) : SQLite, un simple fichier sur le disque du serveur.
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=/home/ubuntu/kendevis/db.sqlite3

# Pour PostgreSQL (recommandé dès qu'il y a plusieurs utilisateurs) :
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=kendevis
# DB_USER=kendevis
# DB_PASSWORD=un_mot_de_passe_tres_solide
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=60