# --- Django ------------------------------------------------------------------
# SECRET_KEY : à générer avec la commande :
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=django-insecure-change-this-in-production-abc123xyz789

# DEBUG : False dès que l'application est en ligne (active HTTPS obligatoire,
# cookies sécurisés, HSTS).
DEBUG=False

# Domaines autorisés, séparés par des virgules. En local :
#   DEBUG=True -> ALLOWED_HOSTS=localhost,127.0.0.1
# Sur le serveur, mets le nom public et l'IP du serveur :
ALLOWED_HOSTS=exemple.com,www.exemple.com,203.0.113.10

# --- Base de données ---------------------------------------------------------
# Par défaut (commenté) : SQLite, un simple fichier sur le disque du serveur.
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=/home/ubuntu/kendevis/db.sqlite3

# Pour PostgreSQL (recommandé dès qu'il y a plusieurs utilisateurs) :
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=kendevis
# DB_USER=kendevis
# DB_PASSWORD=un_mot_de_passe_tres_solide
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=60

# --- Devis et paiement mobile money ----------------------------------------
# Numéro sur lequel l'utilisateur envoie son paiement (format international,
# sans espace : 261384160133).
MOBILE_MONEY_NUMERO=
# Nom du titulaire du compte mobile money, imprimé sur le PDF.
MOBILE_MONEY_NOM=
# Opérateur : MVola, Airtel Money, Moov...
MOBILE_MONEY_OPERATEUR=
# Destinataire du bouton « Envoyer sur WhatsApp » (format international).
WHATSAPP_ADMIN=261384160133

# ⚠️ L'application n'effectue AUCUN transfert mobile money : ces variables
# servent à afficher où payer, et à tracer une déclaration. Un virement réel
# exige un contrat marchand (Orange Money, Airtel...) et des identifiants
# d'API que seul l'administrateur peut obtenir.